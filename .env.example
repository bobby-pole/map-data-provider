# Local development & verification environment template
# Copy to `.env` for local overrides (`.env` is gitignored).

# Server & frontend static assets
NODE_ENV=development
PORT=3001
# STATIC_DIR=/app/static

# Runtime acquisition policy: disabled | demo_fixed_aoi | local_bounded | trusted
MDQ_RUNTIME_MODE=local_bounded
# Required when MDQ_RUNTIME_MODE=demo_fixed_aoi
MDQ_DEMO_AOI_TEMPLATE=rybnik_gmina_demo
MDQ_DEMO_AOI_ID=rybnik_35km
# Required only when MDQ_RUNTIME_MODE=trusted
# MDQ_TRUSTED_ACQUISITION_TOKEN=

# Storage & worker paths (defaults point to repo-local directories)
MDQ_DATA_DIR=./backend/data
MDQ_BACKEND_DIR=./backend
MDQ_PREPARED_ROOT=./backend/data/cache
MDQ_REVIEW_ROOT=./backend/data/reviews
MDQ_RUNTIME_ROOT=./backend/cache
MDQ_MEASUREMENTS_ROOT=./docs/measurements
# MDQ_RUNTIME_PYTHON=./backend/.venv/bin/python

# Rate limiting (240/min default in production; higher values useful for local benchmarks)
MDQ_RATE_LIMIT_MAX_REQUESTS=240

# Container demo bundle bootstrap (used by Dockerfile entrypoint)
# MDQ_BUNDLE_SOURCE=/app/data/bundle/rybnik_35km
MDQ_REQUIRE_DEMO_BUNDLE=false
# MDQ_DEMO_BUNDLE_ID=

# Verification script controls (set to 1 to force `uv run --offline`)
MDQ_OFFLINE=0
